<server>
    const response = await fetch("https://jsonplaceholder.typicode.com/users/1")
    return { name, email, phone, website } = await response.json()
</server>

<div>
    <h1>User Details</h1>

    <p>Name: {name}</p>
    <p>Email: {email}</p>
    <p>Phone: {phone}</p>
    <p>Website: {website}</p>
</div>